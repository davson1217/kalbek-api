APP_NAME=Kalbek
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5174
KALBEK_FRONTEND_URL=http://localhost:3000

# Production baseline:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.kalbek.example
# KALBEK_FRONTEND_URL=https://app.kalbek.example
# FRONTEND_URL="${KALBEK_FRONTEND_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
KALBEK_LOG_API_TRAFFIC=true
KALBEK_LOG_API_RESPONSE_MAX_CHARS=4000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kalbek
DB_USERNAME=kalbek
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDISINSIGHT_PORT=5540

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production mail must use a real provider and verified sender address.
# MAIL_MAILER=resend
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS="hello@kalbek.example"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
KALBEK_AI_MODE=fake
KALBEK_AI_FOR_AUDIO=openrouter
KALBEK_TTS_MODEL=google/gemini-3.1-flash-tts-preview
KALBEK_TTS_PCM_SAMPLE_RATE=24000
KALBEK_TTS_METADATA_CACHE_TTL_SECONDS=86400
KALBEK_TTS_GENERATION_LOCK_SECONDS=60
KALBEK_TTS_GENERATION_LOCK_WAIT_SECONDS=50
KALBEK_GENERATED_AUDIO_DISK=local
KALBEK_GENERATED_AUDIO_PATH=generated-audio
KALBEK_GENERATED_AUDIO_FALLBACK_DISK=local
KALBEK_GENERATED_AUDIO_ALLOW_FALLBACK=false
KALBEK_FAKE_SPEECH_TRANSCRIPT="Ar turite maisto?"
KALBEK_FAKE_SPEECH_PASS=true
KALBEK_FAKE_SPEECH_FEEDBACK="Dev AI mode: speech accepted without calling an AI provider."
OPENROUTER_API_KEY=

# Production AI should be live and all selected providers must have keys.
# KALBEK_AI_MODE=live

KALBEK_TRIAL_DAYS=3
KALBEK_GRACE_DAYS=7
KALBEK_FREE_SCENARIO_LIMIT=2
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_SUCCESS_URL="${KALBEK_FRONTEND_URL}/profile"
STRIPE_CANCEL_URL="${KALBEK_FRONTEND_URL}/profile"
